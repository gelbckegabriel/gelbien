# ── Google sign-in + Google Sheets storage ─────────────────────────────
# Create an OAuth client (type "Web application") in Google Cloud Console.
# Authorized redirect URI: <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Encrypts the session cookie (it carries the Google refresh token).
# At least 32 characters. Generate one with:  openssl rand -base64 32
AUTH_SECRET=

# Public URL of the app. Optional locally (the request origin is used);
# set it in production, e.g. https://gelbien.vercel.app
APP_URL=http://localhost:3000
